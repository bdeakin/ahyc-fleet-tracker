# AISStream.io (free key at https://aisstream.io)
AISSTREAM_API_KEY=

# Server
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
RETENTION_KEEP_OFFSEASON=true

# Home waters around Atlantic Highlands Yacht Club (for trip detection)
HOME_LAT=40.4185
HOME_LON=-74.0385
HOME_RADIUS_NM=0.4

# Sailing season (month-day, inclusive)
SEASON_START=04-01
SEASON_END=10-31

# Supabase (admin registry + auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local admin fallback when Supabase is unset (dev only)
LOCAL_ADMIN_TOKEN=dev-admin-token

# AISStream.io (free key at https://aisstream.io) — required for live tracking
AISSTREAM_API_KEY=

# Carto Basemaps (Voyager harbor layer) — https://carto.com/basemaps
# Railway: CARTO_API_KEY → tiles use ?key=… (recommended in production)
CARTO_API_KEY=

# Server
PORT=8787
HOST=0.0.0.0
# Local: ./data — Railway: /data (attach a volume at /data)
DATA_DIR=./data
RETENTION_KEEP_OFFSEASON=true

# Home waters around Atlantic Highlands Yacht Club (for trip detection)
HOME_LAT=40.4185
HOME_LON=-74.0385
HOME_RADIUS_NM=0.4

# Sailing season (month-day, inclusive)
SEASON_START=04-01
SEASON_END=10-31

# Supabase (optional — admin email login + cloud vessel registry)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for /admin when Supabase is unset. Use a long random string in production.
LOCAL_ADMIN_TOKEN=dev-admin-token


# Pi AIS Dispatcher → HTTPS ingest (must match forwarder AIS_INGEST_TOKEN)
AIS_INGEST_TOKEN=

# Historical chart tiles: pyramids are cut in the background 45s after boot, throttled to
# one sharp thread. Set to 0 on a memory-tight container to cut them on first request instead.
# HISTORICAL_TILE_WARMUP=0
# HISTORICAL_TILE_WARMUP_DELAY_MS=45000

# Harbor traffic retention / downsampling
TRAFFIC_RETENTION_HOURS=24
TRACK_MIN_INTERVAL_SEC=60

# AISHub (https://www.aishub.net/api) — Railway secret AISHUB_USERNAME
# Earning the username means running a station: deploy/AISHUB.md
# Hard limit: one HTTP call per minute (shared by the bbox sweep + MMSI watchlist)
AISHUB_USERNAME=
# AISHUB_MIN_INTERVAL_SEC=300
# AISHUB_BBOX_INTERVAL_SEC=300
# AISHUB_PERIMETER_DEG=0.5

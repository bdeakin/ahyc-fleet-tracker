[Unit]
Description=AHYC AIS Dispatcher → Railway HTTPS forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ahyc-ais-forwarder
EnvironmentFile=-/etc/ahyc-ais-forwarder.env
ExecStart=/opt/ahyc-ais-forwarder/venv/bin/python /opt/ahyc-ais-forwarder/forwarder.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# AHYC AIS forwarder (Pi)
# Copy to /etc/ahyc-ais-forwarder.env and fill in values.

# Public Railway app origin (no trailing slash)
AHYC_INGEST_URL=https://YOUR-APP.up.railway.app

# Must match Railway variable AIS_INGEST_TOKEN
AIS_INGEST_TOKEN=change-me-to-a-long-random-secret

# Where AIS Dispatcher sends UDP NMEA (local only)
AIS_UDP_HOST=127.0.0.1
AIS_UDP_PORT=10110

AIS_FLUSH_SEC=2
AIS_MAX_BATCH=200
LOG_LEVEL=INFO
